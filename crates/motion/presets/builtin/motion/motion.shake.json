{
  "id": "motion.shake",
  "version": 1,
  "domain": "motion",
  "family": "shake",
  "doc": "抖动：x / y 两条 splitmix64 噪声轨（规范 §7.3），composite=add，可叠加主运动。seed 缺省 0。",
  "aliases": [
    "shake"
  ],
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "amplitude": {
      "type": "length",
      "default": {
        "value": 0.008,
        "basis": "canvasShortEdge"
      },
      "doc": "抖动幅度；缺省是画布短边的 0.8%"
    },
    "period": {
      "type": "number",
      "default": 0.12,
      "min": 0.001,
      "doc": "一个噪声周期的秒数；越小越碎"
    },
    "seed": {
      "type": "seed",
      "default": 0,
      "doc": "确定性种子（规范 §7.3）；x / y 由 channel 派生出各自的子种子"
    }
  },
  "ops": [
    {
      "op": "noise",
      "prop": "x",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 1,
      "dur": "{dur}",
      "composite": "add"
    },
    {
      "op": "noise",
      "prop": "y",
      "amplitude": "{amplitude}",
      "period": "{period}",
      "seed": "{seed}",
      "channel": 2,
      "dur": "{dur}",
      "composite": "add"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
