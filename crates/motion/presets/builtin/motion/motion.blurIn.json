{
  "id": "motion.blurIn",
  "version": 1,
  "domain": "motion",
  "family": "blurIn",
  "doc": "失焦入场（blur 通道由阶段 4 的 Filter Pass 消费）。",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "blur": {
      "type": "number",
      "default": 8.0,
      "min": 0.0,
      "doc": "起始模糊半径（px）"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "时间曲线（规范 §7.6 的封闭名称）"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "是否同时淡入/淡出"
    }
  },
  "compose": [
    {
      "preset": "motion.blurFrom",
      "params": {
        "blur": "{blur}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeIn",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
