{
  "id": "motion.rotateOut",
  "version": 1,
  "domain": "motion",
  "family": "rotateIn",
  "doc": "旋转离场（可选淡出）。",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "rotationTo": {
      "type": "number",
      "default": 12.0,
      "doc": "终止角度（度）"
    },
    "curve": {
      "type": "curve",
      "default": "easeInCubic",
      "doc": "时间曲线（规范 §7.6 的封闭名称）"
    },
    "fade": {
      "type": "bool",
      "default": true,
      "doc": "是否同时淡入/淡出"
    }
  },
  "compose": [
    {
      "preset": "motion.spinOut",
      "params": {
        "rotationTo": "{rotationTo}",
        "curve": "{curve}"
      }
    },
    {
      "preset": "motion.fadeOut",
      "when": "{fade}"
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
