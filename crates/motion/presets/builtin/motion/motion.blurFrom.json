{
  "id": "motion.blurFrom",
  "version": 1,
  "domain": "motion",
  "family": null,
  "doc": "内部积木：模糊从 blur 收敛到 0。",
  "exposedTo": [
    "bcf"
  ],
  "params": {
    "blur": {
      "type": "number",
      "default": 8.0,
      "min": 0.0,
      "doc": "起始模糊半径（px）"
    },
    "curve": {
      "type": "curve",
      "default": "easeOutCubic",
      "doc": "时间曲线（规范 §7.6 的封闭名称）"
    }
  },
  "tracks": [
    {
      "prop": "blur",
      "composite": "add",
      "order": 0,
      "frames": [
        {
          "t": "0%",
          "v": "{blur}"
        },
        {
          "t": "100%",
          "v": 0,
          "ease": "{curve}"
        }
      ]
    }
  ],
  "determinism": "strict",
  "capabilities": []
}
