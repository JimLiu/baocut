{
  "id": "filter.grayscale",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "amount": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "grayscale-rec709-f64",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "向 Rec.709 亮度插值：out = in + (gray - in) × amount。"
}
