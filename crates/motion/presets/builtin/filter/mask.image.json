{
  "id": "mask.image",
  "version": 1,
  "domain": "mask",
  "inputs": 2,
  "params": {
    "invert": {
      "type": "bool",
      "default": false
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "alpha-mask-from-pixmap",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "第二个输入的 alpha 通道作为遮罩（尺寸必须与输入一致）。invert 时用 1 - alpha。"
}
