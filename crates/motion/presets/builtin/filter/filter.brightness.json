{
  "id": "filter.brightness",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "amount": {
      "type": "number",
      "default": 0,
      "min": -1,
      "max": 1
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "brightness-unpremul-f64",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "反预乘到 f64、加 amount×255、clamp 后重新预乘并四舍五入。amount ∈ [-1, 1]。"
}
