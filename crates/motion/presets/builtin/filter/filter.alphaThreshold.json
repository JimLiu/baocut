{
  "id": "filter.alphaThreshold",
  "version": 1,
  "domain": "filter",
  "inputs": 1,
  "params": {
    "threshold": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "softness": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    }
  },
  "color": {
    "colorSpace": "srgb-premultiplied",
    "precision": "u8"
  },
  "kernel": "alpha-threshold-smoothstep",
  "origin": "top-left",
  "alpha": "premultiplied",
  "sampling": "nearest",
  "edge": "clamp",
  "resizeMode": "same-as-input",
  "determinism": "strict",
  "capabilities": [],
  "fallback": null,
  "doc": "按 alpha 阈值二值化，softness > 0 时在 [threshold-softness, threshold+softness] 内线性过渡；覆盖率乘在预乘四通道上（预乘不变式 rgb ≤ a 因此保持成立）。"
}
