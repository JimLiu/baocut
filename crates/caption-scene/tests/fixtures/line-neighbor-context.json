{
  "schema": "baocut.caption-scene-style/1",
  "scene": {
    "kind": "inline",
    "value": {
      "schema": "baocut.caption-scene/1",
      "evaluationVersion": 1,
      "requiredCapabilities": [
        "caption-scene/1",
        "caption-expressions/1",
        "caption-line-neighbor-context/1"
      ],
      "parameters": [],
      "layout": {
        "width": {
          "value": 100,
          "basis": "absolute"
        },
        "x": {
          "value": 80,
          "basis": "absolute"
        },
        "y": {
          "value": 45,
          "basis": "absolute"
        },
        "maxLines": 2,
        "pagination": {
          "maxUnitsPerPage": 4
        }
      },
      "speechState": {
        "gapPolicy": "hold-previous",
        "tailPolicy": "none"
      },
      "nodes": [
        {
          "id": "caption",
          "type": "text",
          "style": {
            "fontSize": {
              "value": 16,
              "basis": "absolute"
            }
          },
          "zIndex": 1
        },
        {
          "id": "boxes",
          "type": "repeat",
          "selectorId": "active-word",
          "zIndex": 0,
          "children": [
            {
              "id": "box",
              "type": "shape",
              "properties": {
                "transform.x": {
                  "kind": "expression",
                  "expression": {
                    "op": "if",
                    "condition": {
                      "op": "read",
                      "path": "unit.previousWordInLine"
                    },
                    "then": {
                      "op": "call",
                      "function": "mix",
                      "args": [
                        {
                          "op": "call",
                          "function": "sub",
                          "args": [
                            {
                              "op": "read",
                              "path": "layout.previousWordX"
                            },
                            {
                              "op": "read",
                              "path": "layout.x"
                            }
                          ]
                        },
                        {
                          "op": "literal",
                          "type": "length",
                          "value": 0
                        },
                        {
                          "op": "call",
                          "function": "clamp",
                          "args": [
                            {
                              "op": "call",
                              "function": "div",
                              "args": [
                                {
                                  "op": "read",
                                  "path": "time.elapsedSeconds"
                                },
                                {
                                  "op": "literal",
                                  "type": "time",
                                  "value": 0.1
                                }
                              ]
                            },
                            {
                              "op": "literal",
                              "type": "scalar",
                              "value": 0
                            },
                            {
                              "op": "literal",
                              "type": "scalar",
                              "value": 1
                            }
                          ]
                        }
                      ]
                    },
                    "else": {
                      "op": "literal",
                      "type": "length",
                      "value": 0
                    }
                  }
                },
                "width": {
                  "kind": "expression",
                  "expression": {
                    "op": "call",
                    "function": "sub",
                    "args": [
                      {
                        "op": "if",
                        "condition": {
                          "op": "read",
                          "path": "unit.previousWordInLine"
                        },
                        "then": {
                          "op": "call",
                          "function": "mix",
                          "args": [
                            {
                              "op": "call",
                              "function": "sub",
                              "args": [
                                {
                                  "op": "call",
                                  "function": "add",
                                  "args": [
                                    {
                                      "op": "read",
                                      "path": "layout.previousWordX"
                                    },
                                    {
                                      "op": "read",
                                      "path": "layout.previousWordWidth"
                                    }
                                  ]
                                },
                                {
                                  "op": "read",
                                  "path": "layout.x"
                                }
                              ]
                            },
                            {
                              "op": "read",
                              "path": "layout.width"
                            },
                            {
                              "op": "call",
                              "function": "clamp",
                              "args": [
                                {
                                  "op": "call",
                                  "function": "div",
                                  "args": [
                                    {
                                      "op": "read",
                                      "path": "time.elapsedSeconds"
                                    },
                                    {
                                      "op": "literal",
                                      "type": "time",
                                      "value": 0.1
                                    }
                                  ]
                                },
                                {
                                  "op": "literal",
                                  "type": "scalar",
                                  "value": 0
                                },
                                {
                                  "op": "literal",
                                  "type": "scalar",
                                  "value": 1
                                }
                              ]
                            }
                          ]
                        },
                        "else": {
                          "op": "read",
                          "path": "layout.width"
                        }
                      },
                      {
                        "op": "if",
                        "condition": {
                          "op": "read",
                          "path": "unit.previousWordInLine"
                        },
                        "then": {
                          "op": "call",
                          "function": "mix",
                          "args": [
                            {
                              "op": "call",
                              "function": "sub",
                              "args": [
                                {
                                  "op": "read",
                                  "path": "layout.previousWordX"
                                },
                                {
                                  "op": "read",
                                  "path": "layout.x"
                                }
                              ]
                            },
                            {
                              "op": "literal",
                              "type": "length",
                              "value": 0
                            },
                            {
                              "op": "call",
                              "function": "clamp",
                              "args": [
                                {
                                  "op": "call",
                                  "function": "div",
                                  "args": [
                                    {
                                      "op": "read",
                                      "path": "time.elapsedSeconds"
                                    },
                                    {
                                      "op": "literal",
                                      "type": "time",
                                      "value": 0.1
                                    }
                                  ]
                                },
                                {
                                  "op": "literal",
                                  "type": "scalar",
                                  "value": 0
                                },
                                {
                                  "op": "literal",
                                  "type": "scalar",
                                  "value": 1
                                }
                              ]
                            }
                          ]
                        },
                        "else": {
                          "op": "literal",
                          "type": "length",
                          "value": 0
                        }
                      }
                    ]
                  }
                },
                "height": {
                  "kind": "expression",
                  "expression": {
                    "op": "read",
                    "path": "layout.height"
                  }
                },
                "fill": {
                  "kind": "constant",
                  "value": "#3366FF"
                }
              }
            }
          ]
        }
      ],
      "selectors": [
        {
          "id": "active-word",
          "nodeId": "caption",
          "unit": "word",
          "filter": {
            "kind": "state",
            "value": "active"
          }
        }
      ],
      "animations": []
    }
  }
}
