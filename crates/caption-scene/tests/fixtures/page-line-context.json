{
  "schema": "baocut.caption-scene-style/1",
  "scene": {
    "kind": "inline",
    "value": {
      "schema": "baocut.caption-scene/1",
      "evaluationVersion": 1,
      "requiredCapabilities": [
        "caption-scene/1",
        "caption-expressions/1",
        "caption-word-line-layout/1",
        "caption-unit-font-size/1",
        "caption-page-line-context/1"
      ],
      "parameters": [],
      "layout": {
        "width": {
          "value": 300,
          "basis": "absolute"
        },
        "x": {
          "value": 160,
          "basis": "absolute"
        },
        "y": {
          "value": 90,
          "basis": "absolute"
        },
        "maxLines": 4,
        "pagination": {
          "unit": "word",
          "wordLinePattern": [
            [
              1,
              1,
              1
            ]
          ]
        },
        "layoutEvaluation": "per-sample",
        "overflow": "visible",
        "fontSizeBindings": [
          {
            "id": "middle-line",
            "nodeId": "caption",
            "selectorId": "lines",
            "value": {
              "kind": "expression",
              "expression": {
                "op": "if",
                "condition": {
                  "op": "call",
                  "function": "and",
                  "args": [
                    {
                      "op": "call",
                      "function": "eq",
                      "args": [
                        {
                          "op": "read",
                          "path": "unit.selectedIndex"
                        },
                        {
                          "op": "literal",
                          "type": "scalar",
                          "value": 1
                        }
                      ]
                    },
                    {
                      "op": "call",
                      "function": "eq",
                      "args": [
                        {
                          "op": "read",
                          "path": "unit.pageLineGraphemeCount.0"
                        },
                        {
                          "op": "read",
                          "path": "unit.pageLineGraphemeCount.1"
                        }
                      ]
                    }
                  ]
                },
                "then": {
                  "op": "literal",
                  "type": "length",
                  "value": 32
                },
                "else": {
                  "op": "literal",
                  "type": "length",
                  "value": 16
                }
              }
            }
          }
        ]
      },
      "speechState": {
        "gapPolicy": "hold-previous",
        "tailPolicy": "none"
      },
      "nodes": [
        {
          "id": "caption",
          "type": "text",
          "style": {
            "fontSize": {
              "value": 16,
              "basis": "absolute"
            }
          },
          "zIndex": 1
        }
      ],
      "selectors": [
        {
          "id": "lines",
          "nodeId": "caption",
          "unit": "line"
        }
      ],
      "animations": [
        {
          "id": "align-to-middle",
          "target": {
            "nodeId": "caption",
            "selectorId": "lines"
          },
          "property": "transform.x",
          "composite": "add",
          "value": {
            "kind": "expression",
            "expression": {
              "op": "if",
              "condition": {
                "op": "call",
                "function": "eq",
                "args": [
                  {
                    "op": "read",
                    "path": "unit.index"
                  },
                  {
                    "op": "literal",
                    "type": "scalar",
                    "value": 0
                  }
                ]
              },
              "then": {
                "op": "call",
                "function": "sub",
                "args": [
                  {
                    "op": "call",
                    "function": "add",
                    "args": [
                      {
                        "op": "read",
                        "path": "layout.pageLineBoxX.1"
                      },
                      {
                        "op": "read",
                        "path": "layout.pageLineBoxWidth.1"
                      }
                    ]
                  },
                  {
                    "op": "call",
                    "function": "add",
                    "args": [
                      {
                        "op": "read",
                        "path": "layout.pageLineBoxX.0"
                      },
                      {
                        "op": "read",
                        "path": "layout.pageLineBoxWidth.0"
                      }
                    ]
                  }
                ]
              },
              "else": {
                "op": "if",
                "condition": {
                  "op": "call",
                  "function": "eq",
                  "args": [
                    {
                      "op": "read",
                      "path": "unit.index"
                    },
                    {
                      "op": "literal",
                      "type": "scalar",
                      "value": 2
                    }
                  ]
                },
                "then": {
                  "op": "call",
                  "function": "sub",
                  "args": [
                    {
                      "op": "read",
                      "path": "layout.pageLineBoxX.1"
                    },
                    {
                      "op": "read",
                      "path": "layout.pageLineBoxX.2"
                    }
                  ]
                },
                "else": {
                  "op": "literal",
                  "type": "length",
                  "value": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
