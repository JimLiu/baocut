{
  "schema": "baocut.caption-scene-style/1",
  "scene": {
    "kind": "inline",
    "value": {
      "schema": "baocut.caption-scene/1",
      "evaluationVersion": 1,
      "requiredCapabilities": [
        "caption-word-line-layout/1",
        "caption-keyword-isolation/1"
      ],
      "layout": {
        "width": {
          "value": 140,
          "basis": "absolute"
        },
        "x": {
          "value": 80,
          "basis": "absolute"
        },
        "y": {
          "value": 45,
          "basis": "absolute"
        },
        "maxLines": 2,
        "overflow": "visible",
        "pagination": {
          "wordLinePattern": [
            [
              2,
              2
            ]
          ],
          "isolation": [
            {
              "tag": "keyword",
              "mode": "page"
            },
            {
              "tag": "aside",
              "mode": "line"
            },
            {
              "tag": "plain",
              "mode": "none"
            }
          ]
        }
      },
      "speechState": {
        "timingPolicy": "require-word-timing"
      },
      "nodes": [
        {
          "id": "caption",
          "type": "text",
          "style": {
            "fontSize": {
              "value": 16,
              "basis": "absolute"
            }
          }
        }
      ]
    }
  }
}
