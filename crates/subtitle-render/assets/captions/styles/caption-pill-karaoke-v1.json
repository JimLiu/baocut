{
  "schema": "baocut-caption-style/1",
  "id": "caption-pill-karaoke",
  "version": 1,
  "title": "Pill karaoke",
  "description": "A rounded karaoke pill follows the active word.",
  "tags": [
    "clean",
    "karaoke"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "pillKaraoke",
  "layers": [
    "pill",
    "glyphs"
  ],
  "channels": [
    "opacity",
    "plateX",
    "plateW",
    "plateH",
    "plateR"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "transform",
      "channels": [
        "opacity"
      ],
      "easing": "easeOut",
      "duration": 0.12,
      "fixed": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0.45},
          {"offset": 1, "value": 1}
        ]
      }
    },
    {
      "trigger": "word.active",
      "operator": "plate",
      "channels": [
        "plateX",
        "plateW",
        "plateH",
        "plateR"
      ],
      "easing": "easeInOut",
      "attack": 0.12,
      "release": 0.12,
      "fixed": true,
      "keyframes": {
        "plateX": [
          {"offset": 0, "value": 0, "ease": "easeInOutCubic"},
          {"offset": 1, "value": 1}
        ],
        "plateW": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "plateH": [
          {"offset": 0, "value": 1},
          {"offset": 1, "value": 1.18}
        ],
        "plateR": [
          {"offset": 0, "value": 0.62},
          {"offset": 1, "value": 0.62}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
