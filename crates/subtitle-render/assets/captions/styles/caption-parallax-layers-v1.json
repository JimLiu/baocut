{
  "schema": "baocut-caption-style/1",
  "id": "caption-parallax-layers",
  "version": 1,
  "title": "Parallax layers",
  "description": "Two synchronized bands move at different depths.",
  "tags": [
    "social",
    "editorial"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "dualBand",
  "layoutTokens": {
    "wide": {"width": 0.88, "fontScale": 1.08, "minFontSize": 18, "maxHeight": 0.4, "bandGap": 18},
    "vertical": {"width": 0.9, "fontScale": 0.94, "minFontSize": 16, "maxHeight": 0.32, "bandGap": 12},
    "square": {"width": 0.88, "fontScale": 1, "minFontSize": 17, "maxHeight": 0.36, "bandGap": 15}
  },
  "grouping": {
    "maxWords": 8,
    "pauseThreshold": 0.5,
    "punctuation": true
  },
  "family": "parallaxLayers",
  "layers": [
    "glyphDuplicate",
    "glyphs"
  ],
  "glyphDuplicateLayers": 2,
  "channels": [
    "opacity",
    "dx",
    "dy",
    "scaleX",
    "scaleY",
    "echo"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "transform",
      "channels": [
        "opacity",
        "dx",
        "dy",
        "scaleX",
        "scaleY"
      ],
      "easing": "easeOut",
      "duration": 0.34,
      "byRole": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "dx": [
          {"offset": 0, "value": 0.16},
          {"offset": 1, "value": 0}
        ],
        "dy": [
          {"offset": 0, "value": 0.22, "ease": "easeOutCubic"},
          {"offset": 1, "value": 0}
        ],
        "scaleX": [
          {"offset": 0, "value": 0.9},
          {"offset": 1, "value": 1}
        ],
        "scaleY": [
          {"offset": 0, "value": 0.9},
          {"offset": 1, "value": 1}
        ]
      }
    },
    {
      "trigger": "emphasis.active",
      "operator": "duplicate",
      "channels": [
        "echo"
      ],
      "easing": "easeInOut",
      "attack": 0.1,
      "release": 0.3,
      "roles": ["emphasis", "hero"],
      "keyframes": {
        "echo": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 0.75}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
