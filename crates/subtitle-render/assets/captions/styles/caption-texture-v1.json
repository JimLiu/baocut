{
  "schema": "baocut-caption-style/1",
  "id": "caption-texture",
  "version": 1,
  "title": "Texture",
  "description": "Spoken glyphs reveal a bundled tactile texture.",
  "tags": [
    "editorial",
    "vfx"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "texture",
  "layers": [
    "textureFill",
    "glyphs"
  ],
  "channels": [
    "fillProgress",
    "colorMix"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    },
    {
      "key": "texture",
      "kind": "choice",
      "values": [
        "lava",
        "marble",
        "metal",
        "wood",
        "concrete",
        "rock"
      ]
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "glyphMask",
      "channels": [
        "fillProgress",
        "colorMix"
      ],
      "easing": "linear",
      "fixed": true,
      "keyframes": {
        "fillProgress": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "colorMix": [
          {"offset": 0, "value": 0.35},
          {"offset": 1, "value": 1}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
