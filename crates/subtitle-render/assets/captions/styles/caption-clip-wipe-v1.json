{
  "schema": "baocut-caption-style/1",
  "id": "caption-clip-wipe",
  "version": 1,
  "title": "Clip wipe",
  "description": "Words wipe in on their spoken timing.",
  "tags": [
    "clean",
    "karaoke"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "clipWipe",
  "layers": [
    "glyphs"
  ],
  "channels": [
    "opacity",
    "clipR",
    "colorMix",
    "dx"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "clip",
      "channels": ["opacity", "clipR", "dx"],
      "easing": "easeOut",
      "duration": 0.26,
      "fixed": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "clipR": [
          {"offset": 0, "value": 1, "ease": "easeOutCubic"},
          {"offset": 1, "value": 0}
        ],
        "dx": [
          {"offset": 0, "value": -0.12, "ease": "easeOutCubic"},
          {"offset": 1, "value": 0}
        ]
      }
    },
    {
      "trigger": "word.active",
      "operator": "glyphMask",
      "channels": ["colorMix"],
      "easing": "easeInOut",
      "attack": 0.08,
      "release": 0.14,
      "byRole": true,
      "keyframes": {
        "colorMix": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
