{
  "schema": "baocut-caption-style/1",
  "id": "caption-glitch-rgb",
  "version": 1,
  "title": "RGB glitch",
  "description": "Seeded RGB offsets and scanlines hit the active word.",
  "tags": [
    "vfx",
    "tech"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "glitchRGB",
  "layers": [
    "glyphDuplicate",
    "scanlines",
    "glyphs"
  ],
  "glyphDuplicateLayers": 3,
  "channels": [
    "opacity",
    "dx",
    "rgbSplit"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "transform",
      "channels": ["opacity"],
      "easing": "easeOut",
      "duration": 0.12,
      "fixed": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0.25},
          {"offset": 1, "value": 1}
        ]
      }
    },
    {
      "trigger": "word.active",
      "operator": "duplicate",
      "channels": ["dx", "rgbSplit"],
      "easing": "step",
      "duration": 0.2,
      "attack": 0.05,
      "release": 0.18,
      "procedural": "seededWiggle",
      "keyframes": {
        "dx": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 0}
        ],
        "rgbSplit": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 0.046}
        ]
      },
      "jitter": {"step": 0.05, "amplitude": 0.018}
    }
  ],
  "composite": "screen",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": true,
  "assets": [],
  "fonts": [
    {
      "role": "mono",
      "family": "JetBrains Mono",
      "weights": [
        500,
        700
      ],
      "fallback": [
        "SF Mono",
        "Menlo",
        "PingFang SC"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    },
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    }
  ]
}
