{
  "schema": "baocut-caption-style/1",
  "id": "caption-emoji-pop",
  "version": 1,
  "title": "Emoji pop",
  "description": "Marked words squeeze in with an emoji badge.",
  "tags": [
    "social",
    "playful"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "fallback",
  "layout": "lowerThird",
  "family": "emojiPop",
  "layers": [
    "glyphs",
    "emoji"
  ],
  "channels": [
    "opacity",
    "scaleX",
    "scaleY",
    "rotation",
    "emojiPop",
    "colorMix"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "transform",
      "channels": [
        "opacity",
        "scaleX",
        "scaleY",
        "rotation"
      ],
      "easing": "backOut",
      "duration": 0.2,
      "procedural": "seededWiggle",
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "scaleX": [
          {"offset": 0, "value": 1.18, "ease": "easeOutCubic"},
          {"offset": 0.55, "value": 0.94, "ease": "easeInCubic"},
          {"offset": 1, "value": 1}
        ],
        "scaleY": [
          {"offset": 0, "value": 0.82, "ease": "easeOutCubic"},
          {"offset": 0.55, "value": 1.08, "ease": "easeInCubic"},
          {"offset": 1, "value": 1}
        ],
        "rotation": [
          {"offset": 0, "value": -7},
          {"offset": 1, "value": 0}
        ]
      }
    },
    {
      "trigger": "emphasis.active",
      "operator": "decoration",
      "channels": ["emojiPop", "colorMix"],
      "easing": "backOut",
      "duration": 0.44,
      "roles": ["emphasis", "hero"],
      "fixed": true,
      "procedural": "seededWiggle",
      "keyframes": {
        "emojiPop": [
          {"offset": 0, "value": 0, "ease": "easeOutCubic"},
          {"offset": 0.5, "value": 1.3, "ease": "easeInCubic"},
          {"offset": 1, "value": 1}
        ],
        "colorMix": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": true,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
