{
  "schema": "baocut-caption-style/1",
  "id": "caption-gradient-fill",
  "version": 1,
  "title": "Gradient fill",
  "description": "A moving gradient fills each spoken glyph.",
  "tags": [
    "clean",
    "editorial"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "gradientFill",
  "layers": [
    "gradientFill",
    "glyphs"
  ],
  "channels": [
    "fillProgress",
    "colorMix"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "glyphMask",
      "channels": [
        "fillProgress",
        "colorMix"
      ],
      "easing": "linear",
      "fixed": true,
      "keyframes": {
        "fillProgress": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ],
        "colorMix": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1}
        ]
      }
    }
  ],
  "composite": "normal",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
