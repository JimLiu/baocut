{
  "schema": "baocut-caption-style/1",
  "id": "caption-neon-glow",
  "version": 1,
  "title": "Neon glow",
  "description": "The active word blooms with layered neon light.",
  "tags": [
    "social",
    "vfx"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "neonGlow",
  "layers": [
    "glyphs"
  ],
  "glowLayers": 3,
  "channels": [
    "opacity",
    "glowGain",
    "colorMix"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    }
  ],
  "events": [
    {
      "trigger": "word.enter",
      "operator": "transform",
      "channels": ["opacity"],
      "easing": "easeOut",
      "duration": 0.14,
      "fixed": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 0.38},
          {"offset": 1, "value": 1}
        ]
      }
    },
    {
      "trigger": "word.active",
      "operator": "glow",
      "channels": ["glowGain", "colorMix"],
      "easing": "easeInOut",
      "attack": 0.09,
      "release": 0.34,
      "keyframes": {
        "glowGain": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 1.1}
        ],
        "colorMix": [
          {"offset": 0, "value": 0},
          {"offset": 1, "value": 0.85}
        ]
      }
    }
  ],
  "composite": "screen",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
