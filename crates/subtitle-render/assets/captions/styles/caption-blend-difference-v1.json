{
  "schema": "baocut-caption-style/1",
  "id": "caption-blend-difference",
  "version": 1,
  "title": "Difference",
  "description": "White type inverts against the underlying video.",
  "tags": [
    "clean",
    "vfx"
  ],
  "scripts": [
    "latin",
    "cjk"
  ],
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "cjk": "good",
  "layout": "lowerThird",
  "family": "blendDifference",
  "layers": [
    "glyphs"
  ],
  "channels": [
    "opacity"
  ],
  "tunables": [
    {
      "key": "intensity",
      "kind": "number",
      "min": 0,
      "max": 100,
      "default": 60
    },
    {
      "key": "speed",
      "kind": "number",
      "min": 0.35,
      "max": 2,
      "default": 1
    },
    {
      "key": "composite",
      "kind": "choice",
      "values": [
        "difference",
        "exclusion",
        "screen"
      ]
    }
  ],
  "events": [
    {
      "trigger": "group.enter",
      "operator": "transform",
      "channels": [
        "opacity"
      ],
      "easing": "easeOut",
      "duration": 0.16,
      "fixed": true,
      "keyframes": {
        "opacity": [
          {"offset": 0, "value": 1},
          {"offset": 1, "value": 1}
        ]
      }
    }
  ],
  "composite": "difference",
  "hardKill": true,
  "visibility": {"hold": 0.5, "gapBeforeNext": 0.05, "hardKillAfter": 0.45},
  "seeded": false,
  "assets": [],
  "fonts": [
    {
      "role": "sans",
      "family": "Inter",
      "weights": [
        400,
        600,
        800
      ],
      "fallback": [
        "SF Pro",
        "PingFang SC",
        "Hiragino Sans"
      ],
      "substitution": "substitute",
      "license": "OFL-1.1"
    },
    {
      "role": "sansHeavy",
      "family": "Inter",
      "weights": [
        700,
        900
      ],
      "fallback": [
        "SF Pro Display",
        "PingFang SC Semibold",
        "Hiragino Sans W6"
      ],
      "substitution": "metric-safe",
      "license": "OFL-1.1"
    }
  ]
}
