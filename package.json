{
  "name": "baocut",
  "version": "3.1.1",
  "private": true,
  "description": "BaoCut: an AI video agent with an editable video at the center",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimliu/baocut.git"
  },
  "homepage": "https://github.com/jimliu/baocut#readme",
  "bugs": {
    "url": "https://github.com/jimliu/baocut/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "doctor": "node tools/dev-check.mjs",
    "setup": "npm run doctor && npm run build:engine && npm run build:wasm",
    "predev": "npm run setup",
    "dev": "npm run dev --workspace=@baocut/desktop",
    "predev:lite": "node tools/dev-check.mjs --lite",
    "dev:lite": "npm run dev --workspace=@baocut/desktop",
    "dev:designs": "npm --prefix designs/baocut run dev --",
    "prebuild": "npm run build:wasm && npm run build:catalog && npm run build:agent-skill",
    "build": "npm run build --workspace=@baocut/desktop",
    "start": "npm run start --workspace=@baocut/desktop",
    "runtime": "node --experimental-strip-types apps/runtime/src/main.ts",
    "build:engine": "node tools/build-engine.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "build:web": "npm run build --workspace=@baocut/web",
    "build:catalog": "node --experimental-strip-types tools/catalog-snapshot.ts",
    "build:agent-skill": "node --experimental-strip-types tools/sync-agent-skill.ts",
    "package:win": "npm run build && npm run build:web && node apps/desktop/tools/package-desktop.mjs --variant cpu",
    "package:win:cuda": "npm run build && npm run build:web && node apps/desktop/tools/package-desktop.mjs --variant cuda",
    "package:win:vulkan": "npm run build && npm run build:web && node apps/desktop/tools/package-desktop.mjs --variant vulkan",
    "check:file-fonts": "npm run build && node apps/desktop/tools/check-file-fonts.mjs",
    "check:model-assets": "npm run build && node apps/desktop/tools/check-model-assets.mjs",
    "bench:preview": "npm run build && node apps/desktop/tools/preview-bench.mjs",
    "bench:panels": "npm run build && node apps/desktop/tools/panels-bench.mjs",
    "icons": "node tools/app-icon/render.mjs",
    "precli": "npm run build:catalog",
    "cli": "node --experimental-strip-types apps/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:catalog && npm run build:agent-skill",
    "test": "vitest run",
    "package:mac": "npm run build && npm run build:web && node apps/desktop/tools/package-desktop.mjs --platform mac"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron@44.5.1": true
  }
}
