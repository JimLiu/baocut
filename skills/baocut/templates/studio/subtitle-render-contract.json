  "splitBoundaries": [
    {
      "name": "pure CJK cue splits on the character boundary nearest textA",
      "note": "标尺必须与生成 cue.text 的 join 一致：CJK 相邻不占分隔宽度。每词 +1 的近似会落到 g1.1。",
      "words": [
        {"id":"g1.0","t0":0.0,"t1":0.5,"text":"我","sp":"s1"},
        {"id":"g1.1","t0":0.5,"t1":1.0,"text":"们","sp":"s1"},
        {"id":"g1.2","t0":1.0,"t1":1.5,"text":"今","sp":"s1"},
        {"id":"g1.3","t0":1.5,"t1":2.0,"text":"天","sp":"s1"},
        {"id":"g1.4","t0":2.0,"t1":2.5,"text":"开","sp":"s1"},
        {"id":"g1.5","t0":2.5,"t1":3.0,"text":"始","sp":"s1"},
        {"id":"g1.6","t0":3.0,"t1":3.5,"text":"工","sp":"s1"},
        {"id":"g1.7","t0":3.5,"t1":4.0,"text":"作","sp":"s1"}
      ],
      "baseText": "我们今天开始工作",
      "textA": "我们今天",
      "textB": "开始工作",
      "expectedAt": "g1.3"
    },
    {
      "name": "mixed CJK and Latin cue counts the join separators once each",
      "note": "显示串是「我用 BaoCut 剪视频」：CJK↔Latin 之间各有一个空格，CJK 之间没有。每词 +1 的近似会落到 m1.0。",
      "words": [
        {"id":"m1.0","t0":0.0,"t1":0.4,"text":"我","sp":"s1"},
        {"id":"m1.1","t0":0.4,"t1":0.8,"text":"用","sp":"s1"},
        {"id":"m1.2","t0":0.8,"t1":1.6,"text":"BaoCut","sp":"s1"},
        {"id":"m1.3","t0":1.6,"t1":2.0,"text":"剪","sp":"s1"},
        {"id":"m1.4","t0":2.0,"t1":2.4,"text":"视","sp":"s1"},
        {"id":"m1.5","t0":2.4,"t1":2.8,"text":"频","sp":"s1"}
      ],
      "baseText": "我用 BaoCut 剪视频",
      "textA": "我用",
      "textB": "BaoCut 剪视频",
      "expectedAt": "m1.1"
    },
    {
      "name": "emoji word keeps its own separators on both sides",
      "note": "textA 精确等于某个词边界前缀（距离 0），因此结论与「字符」的计量单位无关——Rust 标量 / Swift 字素 / JS UTF-16 长度各算各的都落在同一边界。emoji 只用单标量、无 ZWJ 与肤色修饰符，否则三端计数各不相同。",
      "words": [
        {"id":"e1.0","t0":0.0,"t1":0.4,"text":"今","sp":"s1"},
        {"id":"e1.1","t0":0.4,"t1":0.8,"text":"天","sp":"s1"},
        {"id":"e1.2","t0":0.8,"t1":1.2,"text":"🎉","sp":"s1"},
        {"id":"e1.3","t0":1.2,"t1":1.6,"text":"开","sp":"s1"},
        {"id":"e1.4","t0":1.6,"t1":2.0,"text":"心","sp":"s1"}
      ],
      "baseText": "今天 🎉 开心",
      "textA": "今天 🎉",
      "textB": "开心",
      "expectedAt": "e1.2"
    }
