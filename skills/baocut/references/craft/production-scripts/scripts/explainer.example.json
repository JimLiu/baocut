{
  "video": "video_0123456789abcdef",
  "bc": ["baocut"],
  "language": "en-US",
  "fps": 30,
  "canvas": { "width": 1920, "height": 1080, "background": "#17110d" },
  "order": ["s01", "intro", "s02", "s03", "outro"],
  "script": { "path": "../script.md", "notePrefixes": ["@", "(", "（", ">", "<!--"] },
  "fixedLines": {
    "intro": ["<fixed opening line, word for word as the user gave it>"],
    "outro": ["<fixed closing line, word for word as the user gave it>"]
  },
  "hold": { "outro": 4.5 },
  "estimateRate": 2.7,
  "voice": {
    "provider": "google",
    "model": "gemini-3.8-flash-tts",
    "voice": "Charon",
    "instructions": "energetic, clear science explainer, conversational",
    "format": "wav",
    "maxPause": 0.3,
    "attach": false
  },
  "asr": { "provider": "google", "model": "gemini-3.5-transcribe", "chunkSeconds": 0 },
  "names": { "narration": "Narration", "footage": "Footage", "watermark": "Watermark", "quote": "Original voice" },
  "bundle": { "pick": ["img"], "keep": ["img/seal.svg"], "exclude": ["fonts/glyphs.txt"], "module": false, "fonts": {}, "alpha": false },
  "captions": { "style": { "y": 86, "fontSize": 28, "fontColor": "#B9B1A3", "sungColor": "#F4E6C8" } },
  "preview": { "caption": { "y": 86, "verticalAlign": "center", "fontSize": 28, "width": 80 } },
  "footage": {
    "clips": "clips.json",
    "layer": "over",
    "label": { "size": 28, "corner": "top-right", "inset": { "x": 2.4, "y": 4 }, "font": "<font family for the label>" },
    "loudness": -17,
    "subs": { "y": 88, "fontSize": 26, "font": "<font family for the video language>", "language": "en", "speaker": { "scale": 0.62, "color": "#BBBBBB" } }
  },
  "fonts": {
    "out": "fonts",
    "faces": {
      "Body": { "src": "/path/to/NotoSerifSC-VF.ttf", "axes": { "wght": 400 }, "file": "body.ttf" },
      "Latin": { "src": "/path/to/SourceSerif4-Regular.otf", "file": "latin.ttf", "subset": "range" }
    }
  },
  "sources": { "file": "sources.json", "csv": "sources.csv" },
  "watermark": {
    "file": "assets/watermark.png",
    "dur": 5,
    "w": 6,
    "y": 70,
    "x": { "left": 5, "right": 95 },
    "at": [{ "seg": "s02", "line": 3, "side": "right" }, { "t": 95.5, "side": "left" }, { "t": 140, "side": "right", "x": 88, "y": 18 }]
  }
}
