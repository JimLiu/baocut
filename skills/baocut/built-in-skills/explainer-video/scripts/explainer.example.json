{
  "video": "video_0123456789abcdef",
  "bc": ["baocut"],
  "language": "en-US",
  "fps": 30,
  "canvas": { "width": 1920, "height": 1080, "background": "#17110d" },
  "order": ["s01", "intro", "s02", "s03", "outro"],
  "script": { "path": "../script.md", "notePrefixes": ["(", "（", ">", "<!--"] },
  "fixedLines": {
    "intro": ["<fixed opening line, word for word as the user gave it>"],
    "outro": ["<fixed closing line, word for word as the user gave it>"]
  },
  "hold": { "outro": 4.5 },
  "estimateRate": 2.7,
  "voice": {
    "provider": "google",
    "model": "gemini-3.8-flash-tts",
    "voice": "Charon",
    "instructions": "energetic, clear science explainer, conversational",
    "format": "wav",
    "attach": false
  },
  "asr": { "provider": "google", "model": "gemini-3.5-transcribe", "chunkSeconds": 0 },
  "names": { "narration": "Narration" },
  "bundle": { "pick": ["img"], "keep": ["img/seal.svg"], "exclude": ["fonts/glyphs.txt"] }
}
